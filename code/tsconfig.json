{
    "compilerOptions": {
        "target": "es2019",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": ".",
        "sourceMap": true,
        "declaration": false
    },
    "include": ["**/*", "**/*.d.ts"],
    "exclude": ["types/**/*"]
}