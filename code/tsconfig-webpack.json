{
    "compilerOptions": {
        "target": "es2019",
        "module": "esnext",
        "jsx": "react-jsx",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": false,
        "noCheck": false,
        "rootDir": "ts",
        "outDir": "../js",
        "sourceMap": true,
        "declaration": false,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true
    },
    "include": ["ts/**/*.ts", "ts/**/*.d.ts"],
    "exclude": ["types/**/*"]
}