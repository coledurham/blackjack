{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": false,
        "sourceMap": true,
        "declaration": false,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "paths": {
            "@/*": ["./ts/*"],
            "@src-types/*": ["../src/types/*"] 
        }
    },
    "include": [
        "ts/**/*",
        "../src/types/**/*"
    ]
}